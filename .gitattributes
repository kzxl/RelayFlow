# Normalize line endings to LF in the repo; check out native on Windows.
* text=auto

# C# / project files
*.cs        text diff=csharp
*.csproj    text
*.slnx      text
*.json      text
*.md        text
*.css       text
*.js        text
*.html      text
*.yml       text
*.yaml      text

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.dll binary
*.nupkg binary
