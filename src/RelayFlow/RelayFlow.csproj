<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>RelayFlow</PackageId>
    <Version>0.2.0</Version>
    <Authors>RelayFlow</Authors>
    <Description>A lightweight, code-first request-relaying library for ASP.NET Core. Forward selected endpoints from an edge API to an internal API after applying your own authentication and authorization, with secure defaults: SSRF allow-listing, spoofed-header stripping, and edge credential swapping. Wraps YARP's IHttpForwarder for correct streaming, hop-by-hop handling, and cancellation.</Description>
    <PackageTags>aspnetcore;reverse-proxy;forwarder;api-gateway;yarp;relay;bff;edge;authentication</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- ASP.NET Core APIs (endpoints, HttpContext) without bringing the full SDK. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- IHttpForwarder: battle-tested byte copying, hop-by-hop, streaming, cancellation. -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
